{
  "name": "@logimaxx/kviews",
  "version": "1.2.1",
  "description": "Class-based JSON:API data binding for the DOM (jQuery, Handlebars, Fetch; collections and items)",
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logimaxx/kviews.git"
  },
  "bugs": {
    "url": "https://github.com/logimaxx/kviews/issues"
  },
  "homepage": "https://github.com/logimaxx/kviews#readme",
  "scripts": {
    "build": "node build.js",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "serve:python": "python3 -m http.server 8000",
    "serve:php": "php -S localhost:8000",
    "serve:node": "npx http-server -p 8000"
  },
  "keywords": [
    "api",
    "data-binding",
    "json-api",
    "jsonapi",
    "collection",
    "item",
    "handlebars",
    "jquery",
    "fetch",
    "crud"
  ],
  "author": {
    "name": "Sergiu Voicu",
    "url": "https://logimaxx.ro"
  },
  "publisher": "Logimaxx System SRL",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@vitest/ui": "^1.0.0",
    "esbuild": "^0.27.3",
    "jsdom": "^23.0.0",
    "rollup": "^4.57.1",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "handlebars": "^4.0.0",
    "jquery": "^3.0.0"
  }
}
